# =============================================================================
# aeV — Adult Event Access Control
# Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp deploy/.env.example .env
#
# Compose will automatically load .env when you run:
#   docker compose -f deploy/docker-compose.yml up
# =============================================================================

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=aev
POSTGRES_PASSWORD=aev_secret
POSTGRES_DB=aev_events

# ─── Go Backend ────────────────────────────────────────────────────────────────
# Database connection (must match PostgreSQL values above)
DB_HOST=postgres
DB_PORT=5432
DB_USER=aev
DB_PASSWORD=aev_secret
DB_NAME=aev_events

# JWT signing secret (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-in-production

# World ID (https://world.org)
WORLD_APP_ID=app_staging
WORLD_ACTION=aev-age-verification

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Server
PORT=8080
LOG_LEVEL=info

# ─── ZK Prover (Rust) ──────────────────────────────────────────────────────────
ZK_PROVER_HOST=0.0.0.0
ZK_PROVER_PORT=3002
ZK_PROVER_LOG_LEVEL=info

# Noir
NOIR_PROVER_BINARY=nargo
NOIR_CIRCUITS_DIR=/circuits

# RISC Zero
RISC0_PROVER_MODE=local       # local | remote (bonsai)
RISC0_BONSAI_API_KEY=
RISC0_BONSAI_API_URL=

# Wasmtime verifier (embedded in Go backend)
WASM_VERIFIER_PATH=/app/verifier.wasm

# ─── Julia Analytics ───────────────────────────────────────────────────────────
# Database connection (must match PostgreSQL values above)
ANALYTICS_DB_HOST=postgres
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_USER=aev
ANALYTICS_DB_PASSWORD=aev_secret
ANALYTICS_DB_NAME=aev_events

ANALYTICS_PORT=8090
ANALYTICS_LOG_LEVEL=warn

# ─── Next.js Frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WORLD_APP_ID=app_staging
NEXT_PUBLIC_WORLD_ACTION=aev-age-verification
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# ─── CI/CD ─────────────────────────────────────────────────────────────────────
CHOREO_WEBHOOK_URL=
DOCKER_REGISTRY=

# ─── Smart Contracts ───────────────────────────────────────────────────────────
# Foundry deployer (used by forge scripts)
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
RPC_URL_SEPOLIA=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
